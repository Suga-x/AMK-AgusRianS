<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Repair Order sequence -->
        <record id="seq_car_repair_order" model="ir.sequence">
            <field name="name">Car Repair Order</field>
            <field name="code">car.repair.order</field>
            <field name="prefix">SR</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Diagnosis sequence -->
        <record id="seq_car_diagnosis" model="ir.sequence">
            <field name="name">Car Diagnosis</field>
            <field name="code">car.diagnosis</field>
            <field name="prefix">DG</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Work Order sequence -->
        <record id="seq_car_work_order" model="ir.sequence">
            <field name="name">Car Work Order</field>
            <field name="code">car.work.order</field>
            <field name="prefix">WO</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
