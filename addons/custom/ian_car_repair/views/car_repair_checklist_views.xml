<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_repair_checklist_list_view" model="ir.ui.view">
        <field name="name">car.repair.checklist.list</field>
        <field name="model">car.repair.checklist</field>
        <field name="arch" type="xml">
            <list string="Checklists">
                <field name="name"/>
                <field name="created_by_id"/>
            </list>
        </field>
    </record>

    <record id="car_repair_checklist_form_view" model="ir.ui.view">
        <field name="name">car.repair.checklist.form</field>
        <field name="model">car.repair.checklist</field>
        <field name="arch" type="xml">
            <form string="Checklist">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="created_by_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_repair_checklist_action" model="ir.actions.act_window">
        <field name="name">Checklists</field>
        <field name="res_model">car.repair.checklist</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first Car Repair Checklist
            </p>
        </field>
    </record>

</odoo>
