<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_work_order_list_view" model="ir.ui.view">
        <field name="name">car.work.order.list</field>
        <field name="model">car.work.order</field>
        <field name="arch" type="xml">
            <list string="Work Orders">
                <field name="name"/>
                <field name="technician_id"/>
                <field name="repair_order_id"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="duration_hours"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="car_work_order_form_view" model="ir.ui.view">
        <field name="name">car.work.order.form</field>
        <field name="model">car.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <button name="action_start" type="object"
                            string="Start"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_resume" type="object"
                            string="Resume"
                            class="oe_highlight"
                            invisible="state != 'pending'"/>
                    <button name="action_pause" type="object"
                            string="Pause"
                            invisible="state != 'in_progress'"/>
                    <button name="action_pending" type="object"
                            string="Pending"
                            invisible="state != 'in_progress'"/>
                    <button name="action_finish" type="object"
                            string="Finish"
                            class="oe_highlight"
                            invisible="state not in ('in_progress', 'pending')"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('finished', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,pending,finished"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="technician_id" groups="ian_car_repair.group_car_repair_head_technician,ian_car_repair.group_car_repair_manager,ian_car_repair.group_car_repair_director"/>
                            <field name="sale_order_id"/>
                            <field name="repair_order_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="diagnosis_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date"/>
                            <field name="priority" widget="priority"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="duration_hours"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="car_work_order_action" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">car.work.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Car Work Order
            </p>
        </field>
    </record>

</odoo>
