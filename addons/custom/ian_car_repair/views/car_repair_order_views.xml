<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_repair_order_list_view" model="ir.ui.view">
        <field name="name">car.repair.order.list</field>
        <field name="model">car.repair.order</field>
        <field name="arch" type="xml">
            <list string="Repair Orders">
                <field name="subject" string="Subject"/>
                <field name="partner_id" string="Client"/>
                <field name="phone" string="Contact Number"/>
                <field name="date_receipt" string="Date of Receipt"/>
                <field name="assigned_id" string="Assigned to"/>
            </list>
        </field>
    </record>

    <record id="car_repair_order_form_view" model="ir.ui.view">
        <field name="name">car.repair.order.form</field>
        <field name="model">car.repair.order</field>
        <field name="arch" type="xml">
            <form string="Repair Order">
                <header>
                    <button name="action_assign_technician" type="object"
                            string="Assign Technician"
                            class="oe_highlight"
                            groups="ian_car_repair.group_car_repair_head_technician,ian_car_repair.group_car_repair_manager,ian_car_repair.group_car_repair_director"
                            invisible="state not in ('draft', 'in_progress') or is_technician_assigned"/>
                    <button name="action_create_diagnosis" type="object"
                            string="Create Car Diagnosis"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_quotation" type="object"
                            string="Create Quotation"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_to_progress" type="object"
                            string="Start Work"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_create_work_order" type="object"
                            string="Create Work Order"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_to_done" type="object"
                            string="Mark Done"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object"
                                class="oe_stat_button"
                                icon="fa-file-text-o"
                                invisible="state == 'draft'"
                                help="View Sale Order">
                            <field name="sale_order_count" widget="statinfo"
                                   string="Sale Order"/>
                        </button>
                        <button name="action_view_work_orders" type="object"
                                class="oe_stat_button"
                                icon="fa-wrench"
                                invisible="state == 'draft'"
                                help="View Work Orders">
                            <field name="work_order_count" widget="statinfo"
                                   string="Work Orders"/>
                        </button>
                        <button name="action_view_diagnosis" type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope"
                                help="View Car Diagnoses">
                            <field name="diagnosis_count" widget="statinfo"
                                   string="Diagnosis"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <group>
                            <group>
                                <field name="subject"/>
                                <field name="assigned_id"/>
                            </group>
                            <group>
                                <field name="priority" widget="priority"/>
                                <field name="date_receipt"/>
                            </group>
                        </group>
                    </div>
                    <notebook>
                        <page string="General">
                            <group string="CLIENT INFO">
                                <group>
                                    <field name="partner_id"/>
                                    <field name="address" nolabel="1"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                </group>
                            </group>
                            <group string="CAR INFO">
                                <field name="line_ids" nolabel="1">
                                    <list string="Vehicle Lines">
                                        <field name="car_id"/>
                                        <field name="license_plate"/>
                                        <field name="model_id"/>
                                        <field name="chassis_number"/>
                                        <field name="fuel_type"/>
                                        <field name="odometer"/>
                                        <field name="under_guarantee"/>
                                        <field name="guarantee_type"/>
                                        <field name="nature_of_service"/>
                                    </list>
                                </field>
                            </group>
                            <group string="WORK ORDERS" invisible="not work_order_ids">
                                <field name="work_order_ids" readonly="1">
                                    <list string="Work Orders">
                                        <field name="name"/>
                                        <field name="technician_id"/>
                                        <field name="state"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Service Repair Checklist">
                            <group string="CHECKLIST ITEMS">
                                <field name="checklist_ids">
                                    <list string="Checklists" editable="bottom">
                                        <field name="name"/>
                                        <field name="created_by_id"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="car_repair_order_line_form_view" model="ir.ui.view">
        <field name="name">car.repair.order.line.form</field>
        <field name="model">car.repair.order.line</field>
        <field name="arch" type="xml">
            <form string="Vehicle Line">
                <header>
                    <button name="action_enter_result" type="object"
                            string="Enter Result"
                            class="oe_highlight"
                            invisible="state != 'in_diagnosis'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_diagnosis,done"/>
                </header>
                <sheet>
                    <group>
                        <group string="Vehicle Information">
                            <field name="car_id"/>
                            <field name="license_plate"/>
                            <field name="odometer"/>
                            <field name="model_id"/>
                            <field name="fuel_type"/>
                            <field name="nature_of_service"/>
                        </group>
                        <group string="Technical Details">
                            <field name="chassis_number"/>
                            <field name="under_guarantee" widget="radio"/>
                            <field name="guarantee_type" widget="radio"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="car_repair_order_action" model="ir.actions.act_window">
        <field name="name">Repair Orders</field>
        <field name="res_model">car.repair.order</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Repair Order
            </p>
        </field>
    </record>

    <record id="car_repair_order_action_kanban" model="ir.actions.act_window">
        <field name="name">Repair Order Board</field>
        <field name="res_model">car.repair.order</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'group_by': 'state'}</field>
    </record>

</odoo>
