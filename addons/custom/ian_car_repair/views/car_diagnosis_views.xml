<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="car_diagnosis_list_view" model="ir.ui.view">
        <field name="name">car.diagnosis.list</field>
        <field name="model">car.diagnosis</field>
        <field name="arch" type="xml">
            <list string="Diagnoses">
                <field name="name"/>
                <field name="repair_order_id"/>
                <field name="partner_id"/>
                <field name="technician_id"/>
                <field name="estimated_hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="car_diagnosis_form_view" model="ir.ui.view">
        <field name="name">car.diagnosis.form</field>
        <field name="model">car.diagnosis</field>
        <field name="arch" type="xml">
            <form string="Diagnosis">
                <header>
                    <button name="action_complete" type="object"
                            string="Mark Complete"
                            class="oe_highlight"
                            invisible="state != 'in_progress'"/>
                    <button name="action_create_quotation" type="object"
                            string="Create Quotation"
                            class="oe_highlight"
                            invisible="state != 'complete'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,complete"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="repair_order_id"/>
                            <field name="partner_id"/>
                            <field name="service_product_id"/>
                        </group>
                        <group>
                            <field name="technician_id"/>
                            <field name="estimated_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnostic Result">
                            <field name="diagnostic_result" placeholder="Describe the diagnostic result..."/>
                        </page>
                        <page string="Spare Parts">
                            <field name="spare_part_ids">
                                <list string="Spare Parts" editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>
                        <page string="Assigned Technician">
                            <group>
                                <group>
                                    <field name="technician_id"
                                           string="Assign Technician"
                                           groups="ian_car_repair.group_car_repair_head_technician,ian_car_repair.group_car_repair_manager,ian_car_repair.group_car_repair_director"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="car_diagnosis_action" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="res_model">car.diagnosis</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Car Diagnosis
            </p>
        </field>
    </record>

</odoo>
