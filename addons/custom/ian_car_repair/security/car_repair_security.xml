<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Security Groups & Category -->
    <record id="module_category_car_repair" model="ir.module.category">
        <field name="name">Car Repair</field>
        <field name="sequence">100</field>
    </record>

    <!-- Group: Technician -->
    <record id="group_car_repair_technician" model="res.groups">
        <field name="name">Technician</field>
        <field name="category_id" ref="module_category_car_repair"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Group: Head Technician -->
    <record id="group_car_repair_head_technician" model="res.groups">
        <field name="name">Head Technician</field>
        <field name="category_id" ref="module_category_car_repair"/>
        <field name="implied_ids" eval="[(4, ref('group_car_repair_technician'))]"/>
    </record>

    <!-- Group: Service Manager -->
    <record id="group_car_repair_manager" model="res.groups">
        <field name="name">Service Manager</field>
        <field name="category_id" ref="module_category_car_repair"/>
        <field name="implied_ids" eval="[(4, ref('group_car_repair_head_technician'))]"/>
    </record>

    <!-- Group: Director Commercial (Full Access) -->
    <record id="group_car_repair_director" model="res.groups">
        <field name="name">Director Commercial</field>
        <field name="category_id" ref="module_category_car_repair"/>
        <field name="implied_ids" eval="[(4, ref('group_car_repair_manager'))]"/>
    </record>

    <!-- Record Rule: Technician sees only own Work Orders -->
    <record id="rule_car_work_order_technician" model="ir.rule">
        <field name="name">Work Order: Technician sees own only</field>
        <field name="model_id" ref="model_car_work_order"/>
        <field name="domain_force">[('technician_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_car_repair_technician'))]"/>
    </record>

    <!-- Record Rule: Head Technician sees all Work Orders -->
    <record id="rule_car_work_order_head_technician" model="ir.rule">
        <field name="name">Work Order: Head Technician sees all</field>
        <field name="model_id" ref="model_car_work_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_car_repair_head_technician'))]"/>
    </record>

    <!-- Record Rule: Technician sees own assigned Repair Orders only -->
    <record id="rule_car_repair_order_technician" model="ir.rule">
        <field name="name">Repair Order: Technician sees own assigned only</field>
        <field name="model_id" ref="model_car_repair_order"/>
        <field name="domain_force">[('assigned_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_car_repair_technician'))]"/>
    </record>

    <!-- Record Rule: Head Technician sees all Repair Orders -->
    <record id="rule_car_repair_order_head_technician" model="ir.rule">
        <field name="name">Repair Order: Head Technician sees all</field>
        <field name="model_id" ref="model_car_repair_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_car_repair_head_technician'))]"/>
    </record>

    <!-- Record Rule: Technician read-only on Diagnosis -->
    <record id="rule_car_diagnosis_technician" model="ir.rule">
        <field name="name">Diagnosis: Technician read-only (all)</field>
        <field name="model_id" ref="model_car_diagnosis"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_car_repair_technician'))]"/>
    </record>

    <!-- Server Action: Open Billing Invoices list -->
    <record id="action_car_repair_billing" model="ir.actions.server">
        <field name="name">Billing Invoices</field>
        <field name="model_id" ref="model_car_repair_billing"/>
        <field name="state">code</field>
        <field name="code">action = model.action_billing_invoices()</field>
    </record>

</odoo>
